{
  "name": "piyasa-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "node server.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "scores": "vitest run -c vitest.research.config.ts research/scores.research.ts",
    "research": "vitest run -c vitest.research.config.ts",
    "outlook": "vitest run -c vitest.research.config.ts research/outlook-export.research.ts --disable-console-intercept",
    "setups": "vitest run -c vitest.research.config.ts research/setups.research.ts --disable-console-intercept",
    "extremes": "vitest run -c vitest.research.config.ts research/extremes.research.ts --disable-console-intercept",
    "market-events": "vitest run -c vitest.research.config.ts research/market-events.research.ts --disable-console-intercept",
    "alarms": "vitest run -c vitest.research.config.ts research/alarms.research.ts --disable-console-intercept"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "lightweight-charts": "^4.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
